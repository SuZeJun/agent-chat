APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://agent_chat:agent_chat_password@127.0.0.1:5433/agent_chat?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MIN_OPEN_CONNS=1
DATABASE_PING_TIMEOUT=2s
DATABASE_MIGRATION_TIMEOUT=30s

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING=false
LLM_TIMEOUT=60s

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT=30s

WORKER_ID=
WORKER_POLL_INTERVAL=2s
WORKER_JOB_TIMEOUT=2m
WORKER_LOCK_TIMEOUT=5m
WORKER_RETRY_BASE_DELAY=2s
WORKER_RETRY_MAX_DELAY=1m

# Docker Compose 演示身份和知识库名称。知识库 ID 留空时由 Web 在服务端按唯一名称解析。
DEMO_CUSTOMER_ID=demo-customer
DEMO_AGENT_ID=demo-agent
DEMO_ADMIN_ID=demo-admin
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_NAME=Agent Chat SaaS 演示知识库

# 宿主端口冲突时可覆盖；容器间通信端口不变。
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5433

# Go API 地址。浏览器不直接访问该地址，仅由 Next.js 路由处理器转发。
API_BASE_URL=http://127.0.0.1:8080

# 演示身份。真实认证接入前，会话归属由该值决定，只存在于服务端。
DEMO_CUSTOMER_ID=demo-customer
DEMO_AGENT_ID=demo-agent

# 客户聊天绑定的知识库。显式 ID 优先；留空时服务端按唯一名称解析 seed 创建的知识库。
# 浏览器不能提交或覆盖这两个值。
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_NAME=Agent Chat SaaS 演示知识库

# Run 详情面向管理员，与客户身份分开。
DEMO_ADMIN_ID=demo-admin

# Go API 地址。浏览器不直接访问该地址，仅由 Next.js 路由处理器转发。
API_BASE_URL=http://127.0.0.1:8080

# 演示身份。真实认证接入前，会话归属由该值决定，只存在于服务端。
DEMO_CUSTOMER_ID=demo-customer

# 客户聊天绑定的知识库。管理员页面可列出知识库，但不会改变客户资源作用域。
# 可通过 POST /api/v1/admin/knowledge-bases 创建后获得 ID。
KNOWLEDGE_BASE_ID=
KNOWLEDGE_BASE_NAME=演示知识库

# Run 详情面向管理员，与客户身份分开。
DEMO_ADMIN_ID=demo-admin
